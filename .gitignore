# 忽略程序运行生成的输出结果文件夹及数据文件
Result/
audit_result*.json
*.xlsx
*.db
customs_hs_sample.db

# 忽略 Streamlit 框架产生的运行配置与缓存
.streamlit/

# 忽略 Python 编译与缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 忽略系统自动生成的垃圾文件
.DS_Store
Thumbs.db

# 忽略 IDE 与编辑器的配置文件
.vscode/
.idea/

# 忽略真实业务单证 (仅允许上传以 sample 结尾的演示单证)
PDF_test_folder/*.pdf
!PDF_test_folder/*sample.pdf